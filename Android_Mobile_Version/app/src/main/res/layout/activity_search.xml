<androidx.constraintlayout.widget.ConstraintLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <!-- Person Input -->
    <AutoCompleteTextView
        android:id="@+id/personTagsEditText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="Enter person tags (e.g. amy, john)"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Location Input -->
    <AutoCompleteTextView
        android:id="@+id/locationTagsEditText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="Enter location tags (e.g. nyc, paris)"
        app:layout_constraintTop_toBottomOf="@id/personTagsEditText"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="8dp" />

    <!-- AND / OR Group -->
    <RadioGroup
        android:id="@+id/logicGroup"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintTop_toBottomOf="@id/locationTagsEditText"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="12dp">

        <RadioButton
            android:id="@+id/radioAnd"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="AND"
            android:checked="true" />

        <RadioButton
            android:id="@+id/radioOr"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="OR"
            android:layout_marginStart="16dp" />
    </RadioGroup>

    <!-- Search Button -->
    <Button
        android:id="@+id/searchButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Search"
        app:layout_constraintTop_toBottomOf="@id/logicGroup"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="16dp" />

    <!-- RecyclerView: fills the rest -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/resultsRecyclerView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/searchButton"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="16dp" />

</androidx.constraintlayout.widget.ConstraintLayout>
